#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for Unix
# ----------------------------------------------------------------------------

set -e

# resolve links - $0 may be a softlink
PRG="$0"

while [ -h "$PRG" ]; do
  ls=$(ls -ld "$PRG")
  link=$(expr "$ls" : '.*-> \(.*\)$')
  if expr "$link" : '/.*' > /dev/null; then
    PRG="$link"
  else
    PRG=$(dirname "$PRG")"/$link"
  fi
done

PRGDIR=$(dirname "$PRG")
BASE_DIR=$(cd "$PRGDIR" && pwd)

# Search for java
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

if ! command -v "$JAVACMD" >/dev/null 2>&1; then
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    echo "Please set JAVA_HOME or use Docker ('docker compose up --build') to run the Spring Boot backend." >&2
    exit 1
fi

WRAPPER_JAR="$BASE_DIR/.mvn/wrapper/maven-wrapper.jar"

# If maven-wrapper.jar doesn't exist, download it
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper JAR..."
    mkdir -p "$BASE_DIR/.mvn/wrapper"
    curl -fsSL -o "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar || {
        echo "Failed to download Maven Wrapper JAR. Please check your internet connection." >&2
        exit 1
    }
fi

exec "$JAVACMD" -jar "$WRAPPER_JAR" "$@"

